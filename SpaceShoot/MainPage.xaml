<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SpaceShoot.MainPage" BackgroundColor="Black"
             Title="Home">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with Score and Lives -->
        <Grid Grid.Row="0" BackgroundColor="#1a1a1a" Padding="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <VerticalStackLayout
                VerticalOptions="Center"
                HorizontalOptions="Start"
                Spacing="0">

                <Label x:Name="ScoreLabel"
                       Text="{Binding Score, StringFormat='Score : {0}'}"
                       TextColor="White"
                       FontSize="18"
                       FontAttributes="Bold"/>

                <Label x:Name="WeaponLabel"
                       Text="Weapon: Single"
                       TextColor="Gold"
                       FontSize="13"
                       FontAttributes="Bold"/>
            </VerticalStackLayout>

            <Button x:Name="StartButton"
                    Grid.Column="1"
                    Text="START"
                    BackgroundColor="#00ff00"
                    TextColor="Black"
                    FontAttributes="Bold"
                    WidthRequest="100"
                    Clicked="OnStartClicked"/>

            <Button x:Name="PauseButton"
                    Grid.Column="2"
                    Text="PAUSE"
                    BackgroundColor="Orange"
                    TextColor="Black"
                    FontAttributes="Bold"
                    WidthRequest="90"
                    Clicked="OnPauseClicked"
                    IsVisible="False"/>

            <Label x:Name="LivesLabel" 
                   Grid.Column="3"
                   Text="Lives: 3" 
                   TextColor="Red" 
                   FontSize="20" 
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   HorizontalOptions="End"/>
        </Grid>

        <!-- Game Background -->
        <Image Grid.Row="1"
               Source="space.jpg"
               Aspect="AspectFill"
               InputTransparent="True" />

        <!-- Game Canvas -->
        <AbsoluteLayout x:Name="GameCanvas" 
                       Grid.Row="1">
            <!-- Gesture recognizers added in code-behind -->
        </AbsoluteLayout>

        <!-- Game Over Overlay -->
        <Grid x:Name="GameOverOverlay" 
              Grid.RowSpan="2"
              BackgroundColor="#CC000000"
              IsVisible="False">
            <VerticalStackLayout HorizontalOptions="Center" 
                                 VerticalOptions="Center"
                                 Spacing="20">
                <Label Text="GAME OVER" 
                       TextColor="Red" 
                       FontSize="48" 
                       FontAttributes="Bold"
                       HorizontalOptions="Center"/>
                <Label x:Name="GameOverHighScoreLabel"
                       Text="High Score: 0"
                       TextColor="Gold"
                       FontSize="24"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"/>
                <Button Text="PLAY AGAIN"
                       BackgroundColor="#00ff00"
                       TextColor="Black"
                       FontAttributes="Bold"
                       WidthRequest="150"
                       Clicked="OnPlayAgainClicked"/>
            </VerticalStackLayout>
        </Grid>
        <!-- Pause Menu Overlay -->
        <Grid x:Name="PauseMenuOverlay"
              Grid.RowSpan="2"
              BackgroundColor="#DD000014"
              IsVisible="False"
              ZIndex="10">

            <Border
                BackgroundColor="#17172B"
                Stroke="#00BFFF"
                StrokeThickness="2"
                Padding="30"
                WidthRequest="300"
                HorizontalOptions="Center"
                VerticalOptions="Center">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>

                <VerticalStackLayout
                    Spacing="20"
                    HorizontalOptions="Center">

                    <Label
                        Text="GAME PAUSED"
                        TextColor="#00BFFF"
                        FontSize="30"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"/>

                    <Label
                        Text="Take a break, pilot!"
                        TextColor="White"
                        FontSize="15"
                        HorizontalOptions="Center"/>

                    <Button
                        Text="RESUME"
                        BackgroundColor="#00FFAA"
                        TextColor="Black"
                        FontAttributes="Bold"
                        WidthRequest="220"
                        Clicked="OnPauseClicked"/>

                    <Button
                        Text="RESTART"
                        BackgroundColor="#2979FF"
                        TextColor="White"
                        FontAttributes="Bold"
                        WidthRequest="220"
                        Clicked="OnRestartClicked"/>

                    <Button
                        Text="MAIN MENU"
                        BackgroundColor="#7B2CBF"
                        TextColor="White"
                        FontAttributes="Bold"
                        WidthRequest="220"
                        Clicked="OnMainMenuClicked"/>

                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>

</ContentPage>
